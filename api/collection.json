  "item": [
    {
      "name": "CT01 - Mochila sem cupom",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/carrinho/calcular",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"itens\": [\n    {\n      \"produtoId\": \"P005\",\n      \"quantidade\": 1\n    }\n  ]\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 200', () => pm.response.to.have.status(200));",
              "pm.test(\"subtotal correto\", () => pm.expect(pm.response.json()).to.have.nested.property(\"subtotal\", 100));",
              "pm.test(\"desconto correto\", () => pm.expect(pm.response.json()).to.have.nested.property(\"desconto\", 0));",
              "pm.test(\"frete correto\", () => pm.expect(pm.response.json()).to.have.nested.property(\"frete\", 19.9));",
              "pm.test(\"total correto\", () => pm.expect(pm.response.json()).to.have.nested.property(\"total\", 119.9));",
              "pm.test(\"freteGratis correto\", () => pm.expect(pm.response.json()).to.have.nested.property(\"freteGratis\", false));",
              "pm.test(\"valorFaltanteFreteGratis correto\", () => pm.expect(pm.response.json()).to.have.nested.property(\"valorFaltanteFreteGratis\", 100));"
            ]
          }
        }
      ]
    },
